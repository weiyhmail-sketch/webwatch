# WebWatch IBKR 连接 secrets —— 模板。
#
# 用法：复制成两份真实文件（不会进 git）：
#   cp config/secrets.env.example config/secrets.paper.env
#   cp config/secrets.env.example config/secrets.live.env
# 然后分别填入 paper / live 的端口与账户号。
#
# 红线：secrets.paper.env / secrets.live.env 绝不进 git、绝不打印。

# 连接地址（IB Gateway / TWS 本机默认 127.0.0.1）
WEBWATCH_IBKR_HOST=127.0.0.1

# 端口：paper=4002，live=4001（务必与文件名对应，防止错连）
WEBWATCH_IBKR_PORT=4002

# clientId：每个连接需唯一；若与 scalper / TWS 冲突会报 clientId 占用，换一个数字
WEBWATCH_IBKR_CLIENT_ID=11

# 账户号：paper 以 DU 开头，live 以 U 开头
WEBWATCH_IBKR_ACCOUNT=DU0000000
